{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Prism Launcher",
  "description": "Manage separate Minecraft instances, mods and accounts.",
  "version": "10.0.5",
  "image": "ghcr.io/containerpak/prism-launcher@sha256:75e76bdef4bd67e8e260f7da6576063c63583bc215405170dd00735a7bcb9d2d",
  "binaries": [
    "/usr/bin/prismlauncher"
  ],
  "desktop_entries": [
    "/usr/share/applications/org.prismlauncher.PrismLauncher.desktop"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "socketWayland": true,
    "socketPulseAudio": true,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": true,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": true,
    "deviceAll": false,
    "notification": true,
    "openURI": true,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
